# ─────────────────────────────────────────────
# App Environment
# ─────────────────────────────────────────────
NODE_ENV=

# ─────────────────────────────────────────────
# API Configuration
# Base URL of the backend REST API.
# In production replace with your deployed backend URL.
# ─────────────────────────────────────────────
NEXT_PUBLIC_PORT=
# NEXT_PUBLIC_PORT=
NEXT_PUBLIC_API_URL=

# ─────────────────────────────────────────────
# WebSocket / Socket.IO
# Should point to the same host as the API (no /api suffix).
# ─────────────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

JWT_ACCESS_SECRET=
ADMIN_SESSION_SECRET=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Verify Cloudinary
BACKEND_API_URL=
BACKEND_VERIFY_PATH=
BACKEND_AUTH_HEADER=
ACCESS_COOKIE_NAME=
