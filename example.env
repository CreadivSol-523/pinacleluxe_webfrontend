# ─────────────────────────────────────────────
# App Environment
# ─────────────────────────────────────────────
NODE_ENV=development

# ─────────────────────────────────────────────
# API Configuration
# Base URL of the backend REST API.
# In production replace with your deployed backend URL.
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ─────────────────────────────────────────────
# WebSocket / Socket.IO
# Should point to the same host as the API (no /api suffix).
# ─────────────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ─────────────────────────────────────────────
# Cloudinary (if images are served directly from the frontend)
# Only needed when the frontend uploads directly to Cloudinary.
# Leave blank if uploads are handled exclusively by the backend.
# ─────────────────────────────────────────────
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ─────────────────────────────────────────────
# App Metadata
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=PinacleLuxe
NEXT_PUBLIC_APP_URL=http://localhost:3000
